# Space-Track (https://www.space-track.org)
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# AI provider: "mock" (default, no network) or "hf"
AI_PROVIDER=mock

# Only when AI_PROVIDER=hf
# HF_TOKEN can be a Hugging Face token (hf_...) or the key of the inference
# provider (e.g. a Groq key, gsk_...)
HF_TOKEN=
HF_MODEL=
# Optional: force the inference provider ("groq", "publicai"...). Empty = automatic
HF_INFERENCE_PROVIDER=